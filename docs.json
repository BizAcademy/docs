        "groups": [
          {
            "group": "Authentification",
            "pages": ["api-reference/authentication/token"]
          },
          {
            "group": "Services",
            "pages": ["api-reference/services/list"]
          },
          {
            "group": "Paiements",
            "pages": ["api-reference/payments/create", "api-reference/payments/show"]
          },
          {
            "group": "Transactions",
            "pages": ["api-reference/transactions/list", "api-reference/transactions/show"]
          },
          {
            "group": "Payouts",
            "pages": ["api-reference/payouts/create", "api-reference/payouts/show"]
          },
          {
            "group": "Remboursements",
            "pages": ["api-reference/refunds/create", "api-reference/refunds/show"]
          },
          {
