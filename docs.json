          },
          {
            "group": "Porteurs de carte",
            "pages": ["api-reference/cardholders/list", "api-reference/cardholders/create", "api-reference/cardholders/show"]
          },
          {
            "group": "Cartes virtuelles",
            "pages": ["api-reference/cards/list", "api-reference/cards/create", "api-reference/cards/quote", "api-reference/cards/show", "api-reference/cards/operate"]
          },
          {
            "group": "Notifications",
            "pages": [
              "api-reference/notifications/send",
              "api-reference/notifications/whatsapp-connect",
              "api-reference/notifications/whatsapp-status"
            ]
          }
        ]
