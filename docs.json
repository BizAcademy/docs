{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "BizConnectPay API",
  "description": "Documentation développeur pour intégrer les paiements et cartes virtuelles BizConnectPay.",
  "colors": {
    "primary": "#006FE8",
    "light": "#16C79A",
    "dark": "#0055B3"
  },
  "favicon": "/favicon.png",
