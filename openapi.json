{
  "openapi": "3.1.0",
  "info": {
    "title": "BizConnectPay API",
    "version": "1.0.0",
    "description": "API serveur-à-serveur pour les collectes, décaissements, transactions, remboursements, liens de paiement et cartes virtuelles."
  },
  "servers": [
    {
      "url": "https://api.bizconnectpay.com/api/v1",
      "description": "Passerelle API BizConnectPay"
    }
  ],
  "tags": [
    { "name": "Authentification" },
    { "name": "Services" },
    { "name": "Collectes" },
    { "name": "Transactions" },
    { "name": "Décaissements" },
    { "name": "Remboursements" },
    { "name": "Liens de paiement" },
    { "name": "Porteurs de carte" },
    { "name": "Cartes virtuelles" },
    { "name": "Notifications" }
  ],
  "paths": {
    "/auth/application/token": {
      "post": {
        "tags": ["Authentification"],
        "summary": "Obtenir un jeton d'application",
        "description": "Échange un Client ID et un secret contre un jeton Bearer RS256 valable 24 heures (86400 secondes). À l'expiration des 24 heures, le marchand doit générer un nouveau jeton.",
        "operationId": "createApplicationToken",
        "servers": [
          { "url": "https://account.bizconnectpay.com/api/v1" }
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ApplicationTokenRequest" },
              "example": {
                "client_id": "BCP_your_client_id",
                "client_secret": "your_application_secret"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Jeton créé",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApplicationTokenResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/services": {
      "get": {
        "tags": ["Services"],
        "summary": "Lister les services disponibles",
        "description": "Retourne les combinaisons pays, devise, opération, méthode et fournisseur actives pour l'environnement de l'application.",
        "operationId": "listServices",
        "responses": {
          "200": {
            "description": "Catalogue disponible",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ServiceCatalogResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/payments": {
      "post": {
        "tags": ["Collectes"],
        "summary": "Initier une collecte",
        "description": "Crée une intention de paiement et lance son orchestration asynchrone. Scope requis : `payments.write`.",
        "operationId": "createPaymentIntent",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/CorrelationId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PaymentIntentRequest" },
              "example": {
                "amount": "15000",
                "currency": "XAF",
                "country": "CM",
                "operation": "COLLECTION",
                "payment_method": "mtn_momo",
                "payer": {
                  "phone_number": "+237671234567",
                  "lang": "fr"
                },
                "description": "Paiement commande 9481",
                "metadata": { "client_reference": "CMD-2026-9481" }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/payments/{paymentIntent}": {
      "get": {
        "tags": ["Collectes"],
        "summary": "Consulter une intention de paiement",
        "operationId": "getPaymentIntent",
        "parameters": [
          {
            "name": "paymentIntent",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/transactions": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Lister les transactions",
        "operationId": "listTransactions",
        "parameters": [
          { "$ref": "#/components/parameters/PerPage" },
          { "name": "currency", "in": "query", "schema": { "type": "string", "minLength": 3, "maxLength": 3 } },
          { "name": "environment", "in": "query", "schema": { "type": "string", "enum": ["SANDBOX", "LIVE"] } },
          { "name": "operation", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 120 } },
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" }
        }
      }
    },
    "/transactions/{reference}": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Consulter une transaction",
        "operationId": "getTransaction",
        "parameters": [
          { "$ref": "#/components/parameters/Reference" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/payouts": {
      "post": {
        "tags": ["Décaissements"],
        "summary": "Créer un payout",
        "description": "Débite un wallet et envoie les fonds au destinataire. Scope requis : `withdrawals.write`.",
        "operationId": "createPayout",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/CorrelationId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WithdrawalRequest" },
              "example": {
                "wallet_id": "4e969910-8f06-4cd2-b92c-01765472e0e9",
                "amount": "25000",
                "currency": "XOF",
                "country": "CI",
                "payment_method": "orange_money",
                "destination": "+2250701020304",
                "metadata": { "client_reference": "PAYOUT-5012" }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/payouts/{reference}": {
      "get": {
        "tags": ["Décaissements"],
        "summary": "Consulter un payout",
        "operationId": "getPayout",
        "parameters": [
          { "$ref": "#/components/parameters/Reference" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/refunds": {
      "post": {
        "tags": ["Remboursements"],
        "summary": "Demander un remboursement",
        "operationId": "createRefund",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefundRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/refunds/{reference}": {
      "get": {
        "tags": ["Remboursements"],
        "summary": "Consulter un remboursement",
        "operationId": "getRefund",
        "parameters": [
          { "$ref": "#/components/parameters/Reference" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/payment-links": {
      "get": {
        "tags": ["Liens de paiement"],
        "summary": "Lister les liens de paiement",
        "operationId": "listPaymentLinks",
        "parameters": [
          { "$ref": "#/components/parameters/PerPage" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "EXPIRED"] } }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "post": {
        "tags": ["Liens de paiement"],
        "summary": "Créer un lien de paiement",
        "operationId": "createPaymentLink",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PaymentLinkRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/payment-links/{paymentLink}": {
      "get": {
        "tags": ["Liens de paiement"],
        "summary": "Consulter un lien de paiement",
        "operationId": "getPaymentLink",
        "parameters": [
          {
            "name": "paymentLink",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/payment-links/{code}/checkout": {
      "get": {
        "tags": ["Liens de paiement"],
        "summary": "Afficher un checkout public",
        "operationId": "getPublicPaymentLinkCheckout",
        "security": [],
        "parameters": [
          { "name": "code", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Données du checkout et moyens de paiement disponibles",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PublicPaymentLinkCheckoutResponse" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["Liens de paiement"],
        "summary": "Envoyer une demande de paiement depuis le checkout",
        "operationId": "submitPublicPaymentLinkCheckout",
        "security": [],
        "parameters": [
          { "name": "code", "in": "path", "required": true, "schema": { "type": "string", "maxLength": 20 } },
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "maxLength": 100 } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PaymentLinkCheckoutRequest" } }
          }
        },
        "responses": {
          "202": { "$ref": "#/components/responses/Accepted" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/cardholders": {
      "get": {
        "tags": ["Porteurs de carte"],
        "summary": "Lister les porteurs de carte",
        "operationId": "listVirtualCardUsers",
        "parameters": [{ "$ref": "#/components/parameters/PerPage" }],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "post": {
        "tags": ["Porteurs de carte"],
        "summary": "Créer un porteur de carte",
        "operationId": "createVirtualCardUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VirtualCardUserRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/cardholders/{virtualCardCustomer}": {
      "get": {
        "tags": ["Porteurs de carte"],
        "summary": "Consulter un porteur de carte",
        "operationId": "getVirtualCardUser",
        "parameters": [
          {
            "name": "virtualCardCustomer",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/cards": {
      "get": {
        "tags": ["Cartes virtuelles"],
        "summary": "Lister les cartes virtuelles",
        "operationId": "listVirtualCards",
        "parameters": [{ "$ref": "#/components/parameters/PerPage" }],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      },
      "post": {
        "tags": ["Cartes virtuelles"],
        "summary": "Émettre une carte virtuelle",
        "description": "Un compte marchand peut créer au maximum 3 cartes virtuelles. L'émission au-delà de cette limite est refusée avec 422.",
        "operationId": "createVirtualCard",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VirtualCardRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Created" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/cards/quote": {
      "get": {
        "tags": ["Cartes virtuelles"],
        "summary": "Obtenir un devis d'émission",
        "operationId": "quoteVirtualCard",
        "parameters": [
          {
            "name": "debit_currency",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "minLength": 3, "maxLength": 3 },
            "description": "Devise préférée pour le débit. Facultative; le serveur peut choisir un autre portefeuille actif suffisamment approvisionné.",
            "example": "CDF"
          }
        ],
        "responses": { "200": { "$ref": "#/components/responses/Success" } }
      }
    },
    "/cards/{virtualCard}": {
      "get": {
        "tags": ["Cartes virtuelles"],
        "summary": "Consulter le détail sensible d'une carte",
        "description": "Retourne les données en temps réel du fournisseur et l'historique. Scope requis : `virtual_cards.cards.sensitive.read`. La réponse ne doit jamais être mise en cache ou journalisée.",
        "operationId": "getVirtualCard",
        "parameters": [
          {
            "name": "virtualCard",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/cards/{virtualCard}/operations": {
      "post": {
        "tags": ["Cartes virtuelles"],
        "summary": "Gérer une carte virtuelle",
        "description": "Alimente, retire, active, désactive ou termine une carte. L'action withdraw exige une idempotency_key; ses frais configurés (initialement 2 USD) sont convertis selon le taux actif.",
        "operationId": "operateVirtualCard",
        "parameters": [
          {
            "name": "virtualCard",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VirtualCardOperationRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/notifications/messages": {
      "post": {
        "tags": ["Notifications"],
        "summary": "Envoyer une notification",
        "description": "Envoie une notification par e-mail, SMS et/ou WhatsApp via le même endpoint. Utilisez `channels` et `recipients` pour diffuser sur plusieurs canaux en un seul appel. Scope requis : `notifications.write`.",
        "operationId": "sendNotificationMessage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NotificationMessageRequest" }
            }
          }
        },
        "responses": {
          "202": { "$ref": "#/components/responses/Accepted" },
          "207": { "$ref": "#/components/responses/Accepted" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/whatsapp/session/connect": {
      "post": {
        "tags": ["Notifications"],
        "summary": "Connecter une session WhatsApp (Baileys)",
        "description": "Génère un QR Code ou un code de jumelage à 8 chiffres pour lier un numéro WhatsApp d'entreprise ou individuel au worker Baileys.",
        "operationId": "connectWhatsAppSession",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WhatsAppConnectRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/whatsapp/session/status": {
      "get": {
        "tags": ["Notifications"],
        "summary": "Consulter le statut de la session WhatsApp",
        "description": "Indique si la session WhatsApp est connectée, déconnectée ou en attente d'authentification QR.",
        "operationId": "getWhatsAppSessionStatus",
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/whatsapp/session/disconnect": {
      "post": {
        "tags": ["Notifications"],
        "summary": "Déconnecter la session WhatsApp",
        "description": "Ferme le socket WhatsApp et réinitialise les identifiants d'authentification de la session.",
        "operationId": "disconnectWhatsAppSession",
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Clé unique et stable pour cette opération métier.",
        "schema": { "type": "string", "maxLength": 255 }
      },
      "CorrelationId": {
        "name": "X-Correlation-ID",
        "in": "header",
        "required": false,
        "schema": { "type": "string", "format": "uuid" }
      },
      "Reference": {
        "name": "reference",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
      }
    },
    "schemas": {
      "ApplicationTokenRequest": {
        "type": "object",
        "required": ["client_id", "client_secret"],
        "properties": {
          "client_id": { "type": "string", "maxLength": 80 },
          "client_secret": { "type": "string", "maxLength": 255, "writeOnly": true }
        }
      },
      "ApplicationTokenResponse": {
        "type": "object",
        "required": ["success", "data", "meta"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "data": {
            "type": "object",
            "required": ["access_token", "expires_in", "token_type", "environment", "scope"],
            "properties": {
              "access_token": { "type": "string" },
              "expires_in": { "type": "integer", "example": 86400, "description": "Durée de validité du jeton en secondes (24 heures = 86400 secondes)." },
              "token_type": { "type": "string", "const": "Bearer" },
              "environment": { "type": "string", "enum": ["SANDBOX", "LIVE"] },
              "scope": { "type": "string" }
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "PaymentIntentRequest": {
        "type": "object",
        "required": ["country", "amount", "currency", "operation", "payment_method"],
        "properties": {
          "country": { "type": "string", "minLength": 2, "maxLength": 2, "example": "CM" },
          "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$" },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3, "example": "XAF" },
          "operation": { "type": "string", "enum": ["COLLECTION", "DEPOSIT", "WITHDRAWAL", "REFUND", "TRANSFER", "PAYOUT", "REVERSAL", "FX_CONVERSION"] },
          "payment_method": { "type": "string", "maxLength": 60 },
          "payer": {
            "type": "object",
            "properties": {
              "phone_number": { "type": "string", "maxLength": 32, "description": "Required for mobile-money collections; omitted for crypto payment intents." },
              "email": { "type": "string", "format": "email", "maxLength": 254 },
              "first_name": { "type": "string", "maxLength": 80 },
              "last_name": { "type": "string", "maxLength": 80 },
              "return_url": { "type": "string", "format": "uri", "maxLength": 2048 },
              "otp_code": {
                "type": ["string", "null"],
                "maxLength": 32,
                "description": "Optional customer OTP. Send it when the selected service reports otp_required=true."
              },
              "lang": { "type": "string", "enum": ["en", "fr"] }
            }
          },
          "description": { "type": ["string", "null"], "maxLength": 1000 },
          "metadata": { "type": "object", "additionalProperties": true, "description": "For crypto collections, may include accepted_coins as a list of supported assets." },
          "expires_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "WithdrawalRequest": {
        "type": "object",
        "required": ["wallet_id", "amount", "currency", "country", "payment_method", "destination"],
        "properties": {
          "wallet_id": { "type": "string", "format": "uuid" },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
          "country": { "type": "string", "minLength": 2, "maxLength": 2 },
          "payment_method": { "type": "string" },
          "destination": { "type": "string" },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Crypto payouts may set asset_code, amount_type (fiat or crypto), destination_memo and fee_bearer (merchant or customer)."
          }
        }
      },
      "RefundRequest": {
        "type": "object",
        "required": ["transaction_reference", "wallet_id", "amount", "reason"],
        "properties": {
          "transaction_reference": { "type": "string" },
          "wallet_id": { "type": "string", "format": "uuid" },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "reason": { "type": "string" }
        }
      },
      "PaymentLinkRequest": {
        "type": "object",
        "required": ["amount", "currency"],
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Montant à collecter, avec au plus quatre décimales."
          },
          "application_id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "examples": ["XAF"]
          },
          "description": {
            "type": ["string", "null"],
            "maxLength": 1000
          },
          "expires_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Date d'expiration future au format ISO 8601."
          },
          "max_uses": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        }
      },
      "PaymentLinkCheckoutRequest": {
        "type": "object",
        "required": ["email", "phone_number", "payment_method"],
        "additionalProperties": false,
        "properties": {
          "amount": { "type": ["string", "number", "null"], "pattern": "^[0-9]+(\\.[0-9]{1,4})?$", "description": "Montant requis uniquement si le lien autorise un montant personnalisé." },
          "country": { "type": ["string", "null"], "minLength": 2, "maxLength": 3, "description": "Pays du payeur si le checkout autorise le choix du pays." },
          "currency": { "type": ["string", "null"], "minLength": 3, "maxLength": 3 },
          "email": { "type": "string", "format": "email", "maxLength": 255 },
          "lang": { "type": ["string", "null"], "enum": ["en", "fr", null] },
          "otp_code": { "type": ["string", "null"], "maxLength": 32, "description": "Code à usage unique, à fournir lorsque la méthode sélectionnée indique otp_required=true." },
          "phone_number": { "type": "string", "pattern": "^\\+[1-9][0-9]{7,14}$", "examples": ["+237690000000"] },
          "payment_method": { "type": "string", "maxLength": 60, "examples": ["MOBILE_MONEY"] }
        }
      },
      "PublicPaymentLinkCheckoutResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": true },
          "data": {
            "type": "object",
            "properties": {
              "payment_methods": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/CheckoutPaymentMethod" }
              },
              "countries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string" },
                    "currency": { "type": "string" },
                    "operators": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/CheckoutPaymentMethod" }
                    }
                  }
                }
              }
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "CheckoutPaymentMethod": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "label": { "type": "string" },
          "otp_required": { "type": "boolean" }
        }
      },
      "VirtualCardUserRequest": {
        "type": "object",
        "required": ["first_name", "last_name", "email", "country_code", "contact", "dob", "billing_name", "is_business", "billing_address", "billing_city", "billing_country", "billing_state", "billing_postal_code", "id_number"],
        "properties": {
          "first_name": { "type": "string", "maxLength": 100 },
          "last_name": { "type": "string", "maxLength": 100 },
          "email": { "type": "string", "format": "email" },
          "country_code": { "type": "string", "maxLength": 5 },
          "contact": { "type": "string", "maxLength": 32 },
          "dob": { "type": "string", "format": "date", "description": "Le porteur doit avoir au moins 18 ans." },
          "billing_name": { "type": "string", "maxLength": 200 },
          "is_business": { "type": "boolean" },
          "business_name": { "type": ["string", "null"], "maxLength": 200 },
          "billing_address": { "type": "string", "maxLength": 255 },
          "billing_city": { "type": "string", "maxLength": 120 },
          "billing_country": { "type": "string", "minLength": 2, "maxLength": 2 },
          "billing_state": { "type": "string", "maxLength": 120 },
          "billing_postal_code": { "type": "string", "maxLength": 32 },
          "id_number": { "type": "string", "maxLength": 100 }
        }
      },
      "VirtualCardRequest": {
        "type": "object",
        "required": ["customer_id", "idempotency_key"],
        "properties": {
          "customer_id": { "type": "string", "format": "uuid" },
          "idempotency_key": { "type": "string", "maxLength": 100 },
          "debit_currency": { "type": "string", "minLength": 3, "maxLength": 3, "description": "Préférence facultative. Le serveur sélectionne automatiquement un portefeuille actif suffisamment approvisionné." },
          "initial_balance": { "type": ["number", "null"], "minimum": 0 },
          "category": { "type": ["string", "null"], "enum": ["PERSONAL", "PROFESSIONAL", null], "description": "Catégorie du porteur. PROFESSIONAL est transmise au fournisseur comme catégorie professionnelle/entreprise." },
          "grade": { "type": ["string", "null"], "enum": ["PREMIUM", null], "description": "PREMIUM est actuellement disponible; BASIC n'est pas disponible." }
        }
      },
      "VirtualCardOperationRequest": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "enum": ["topup", "withdraw", "enabled", "disabled", "terminate"] },
          "amount": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "Obligatoire pour topup et withdraw." },
          "idempotency_key": { "type": "string", "maxLength": 100, "description": "Obligatoire pour withdraw; réutilisez la même clé lors d'une nouvelle tentative de la même opération." }
        }
      },
      "ServiceCatalogResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": true },
          "data": {
            "type": "object",
            "properties": {
              "environment": { "type": "string", "enum": ["SANDBOX", "LIVE"] },
              "services": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "country": { "type": "object", "additionalProperties": true },
                    "currency": { "type": "object", "additionalProperties": true },
                    "operation": { "type": "string" },
                    "payment_method": { "type": "string" },
                    "method_type": { "type": "string", "enum": ["MOBILE_MONEY", "CRYPTO", "OTHER"] },
                    "accepted_coins": { "type": "array", "items": { "type": "string" } },
                    "crypto_asset_code": { "type": ["string", "null"], "description": "Configured crypto payout asset for the service, when applicable." },
                    "otp_required": {
                      "type": "boolean",
                      "description": "True when at least one active provider route for this method may require a customer OTP."
                    },
                    "available": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "NotificationMessageRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "channel": { "type": "string", "enum": ["SMS", "EMAIL", "WHATSAPP"], "description": "Canal unique (alternative à channels)." },
          "channels": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "enum": ["SMS", "EMAIL", "WHATSAPP"] } },
          "recipient_address": { "type": "string", "description": "Adresse unique (alternative à recipients)." },
          "recipients": { "type": "object", "description": "Destinataires par canal, par exemple EMAIL, SMS et WHATSAPP.", "properties": { "EMAIL": { "type": "string", "format": "email" }, "SMS": { "type": "string" }, "WHATSAPP": { "type": "string" } } },
          "message": { "type": "string", "description": "Contenu texte de la notification" },
          "subject": { "type": "string", "description": "Objet de la notification (EMAIL)" }
        }
      },
      "WhatsAppConnectRequest": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "enum": ["QR", "PAIRING_CODE"], "default": "QR" },
          "phone_number": { "type": "string", "description": "Numéro international si mode=PAIRING_CODE (+237...)" }
        }
      },
      "SuccessEnvelope": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": true },
          "data": {},
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": false },
          "data": {
            "type": "object",
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "code": { "type": "string" },
                  "message": { "type": "string" },
                  "details": { "type": ["object", "array"] }
                }
              }
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "correlation_id": { "type": ["string", "null"], "format": "uuid" }
        }
      }
    },
    "responses": {
      "Success": {
        "description": "Requête traitée",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } }
      },
      "Created": {
        "description": "Ressource créée",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } }
      },
      "Accepted": {
        "description": "Demande acceptée pour traitement",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } }
      },
      "Unauthenticated": {
        "description": "Authentification requise ou invalide",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "Forbidden": {
        "description": "Scope ou état de compte insuffisant",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "NotFound": {
        "description": "Ressource introuvable",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "ValidationError": {
        "description": "Payload ou règle métier invalide",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    }
  },
  "security": [
    { "bearerAuth": [] }
  ]
}
